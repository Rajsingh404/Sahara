# Data and training artefacts
data/raw/*
!data/raw/**/.gitkeep
!data/raw/indian_ambient/metadata.csv
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/**/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
models/logs/*
!models/logs/.gitkeep

.venv/
venv/
__pycache__/
*.pyc
.DS_Store

# Secrets and credentials
.env
.env.*
*.pem
*.key
credentials.json
secrets.json

# Audio files (defense in depth — datasets stay local / on Google Drive)
*.wav
*.mp3
*.flac
*.ogg
*.m4a

# Model checkpoints and large training artefacts
models/exported/*
!models/exported/.gitkeep
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.tflite

# Large archives and downloads
*.tar
*.tar.gz
*.zip
datasets/

# Android
android/**/build/
android/**/.gradle/
*.apk
local.properties

# PlatformIO
firmware/**/.pio/

# Flutter
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/android/app/build/
# Final model shipped with the app is allowed
!app/assets/*.tflite

# TF-Hub model download (YAMNet)
models/tfhub_cache/

# Run records are small text files and are committed; models stay out.
!models/logs/*/
models/logs/*/*
!models/logs/*/config.json
!models/logs/*/metrics.json
!models/logs/*/history.csv
!models/logs/*/label_order.txt
!models/logs/*/confusion_val.csv
!models/logs/*/confusion_val.png
!models/logs/runs_summary.csv
!models/logs/selected_run.txt
!models/logs/*/class_thresholds.json
!models/logs/*/test_*.json
!models/logs/*/confusion_test_*
!models/logs/*/false_alarms.json
!models/logs/*/export_validation.json
!models/logs/*/app_pipeline_check.json
!models/logs/personalization/
models/logs/personalization/*
!models/logs/personalization/*.json
!models/logs/phone/
models/logs/phone/*
!models/logs/phone/*.json
